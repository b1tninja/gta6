# Copy to .env in this directory ( .env is gitignored ).

# Xbox / install layout (read-only source tree)
GTA6_GAME_ROOT=M:\Downloads\GTA6.Xbox.v1.0.2.1-CYBERLEEK

# Large extractions and binaries — never inside the git repo
GTA6_ARTIFACT_ROOT=D:\data\gta6\artifacts

# Optional: where `gta6 extract-scripts` writes extracted archive content.
# Default is a sibling of GTA6_ARTIFACT_ROOT (so D:\data\gta6\rpf here).
# GTA6_RPF_OUTPUT_ROOT=D:\data\gta6\rpf

# Optional: use M:\data\gta6\artifacts instead of D:\data

# Optional: exe used to recover the whitened-CBC key-context for RPF9 extraction, and
# for `gta6 net-offline`. Default is game_scarlett_master.exe under GTA6_GAME_ROOT, so
# this is only needed for a relocated install.
# GTA6_GAME_EXE=M:\path\to\game_scarlett_master.exe

# When available: 32-byte AES key for RPF9 TOC (hex) or raw key file
# GTA6_AES_KEY_HEX=
# GTA6_AES_KEY_FILE=D:\data\gta6\keys\scarlett_aes.bin